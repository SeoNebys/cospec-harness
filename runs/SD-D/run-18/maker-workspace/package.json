{
  "name": "keepsake-bookmarks",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch apps/server/src/main.ts",
    "dev:web": "vite --config apps/web/vite.config.ts --host 0.0.0.0",
    "build": "vite build --config apps/web/vite.config.ts && tsc -p tsconfig.server.json",
    "migrate": "node scripts/migrate.mjs",
    "start": "node scripts/start.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run packages",
    "test:integration": "vitest run tests/integration tests/contract",
    "test:security": "vitest run tests/security",
    "test:performance": "vitest run tests/performance",
    "test:e2e": "playwright test",
    "install:monolith": "node scripts/install-monolith.mjs",
    "backup": "node scripts/backup.mjs backup",
    "maintenance": "node dist/server/apps/server/src/maintenance/cli.js"
  },
  "dependencies": {
    "@fastify/multipart": "9.2.1",
    "@fastify/static": "10.1.4",
    "@sinclair/typebox": "0.34.41",
    "better-sqlite3": "13.0.3",
    "dompurify": "3.4.16",
    "fastify": "5.12.5",
    "jsdom": "26.1.0",
    "marked": "16.3.0",
    "parse5": "7.3.0",
    "playwright": "1.61.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "undici": "8.11.2"
  },
  "devDependencies": {
    "@eslint/js": "9.36.0",
    "@playwright/test": "1.61.0",
    "@types/better-sqlite3": "7.6.13",
    "@types/jsdom": "21.1.7",
    "@types/node": "24.5.2",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "9.2.4",
    "eslint": "9.36.0",
    "globals": "16.4.0",
    "prettier": "3.6.2",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "typescript-eslint": "8.44.1",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
