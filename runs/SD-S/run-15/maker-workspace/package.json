{
  "name": "bookmark-manager",
  "version": "1.0.0",
  "description": "Single-user local bookmark manager",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test \"tests/unit/**/*.test.js\" \"tests/integration/**/*.test.js\"",
    "test:perf": "node tests/perf.js | grep -q 'PERF OK'",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "playwright": "1.61.0",
    "@playwright/test": "1.61.0"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true
  }
}
