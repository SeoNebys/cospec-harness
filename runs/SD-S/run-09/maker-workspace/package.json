{
  "name": "private-bookmark-library",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "concurrently -k \"vite --host 0.0.0.0\" \"tsx watch src/server/index.ts\"",
    "build": "npm run typecheck && vite build",
    "start": "node --env-file-if-exists=.env --import tsx src/server/index.ts",
    "typecheck": "tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit tests/component",
    "test:integration": "vitest run tests/integration tests/contract",
    "test:e2e": "playwright test",
    "db:migrate": "node --env-file-if-exists=.env --import tsx src/server/db/migrate.ts",
    "db:rebuild-search": "node --env-file-if-exists=.env --import tsx scripts/rebuild-search.ts",
    "seed:review": "node --env-file-if-exists=.env --import tsx scripts/seed-review.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.4",
    "better-auth": "1.7.5",
    "better-sqlite3": "13.0.3",
    "cheerio": "1.2.0",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.5",
    "nodemailer": "10.0.10",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.61.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.10.1",
    "@types/nodemailer": "7.0.4",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.24",
    "globals": "16.5.0",
    "jsdom": "27.2.0",
    "prettier": "3.7.4",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.1",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
