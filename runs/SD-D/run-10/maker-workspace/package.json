{
  "name": "bookmark-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "dev": "concurrently -k -n server,client \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch src/server/server.ts",
    "dev:client": "vite --host 0.0.0.0 --port 5173",
    "start": "node dist/server/server/server.js",
    "db:migrate": "tsx src/server/db/migrate-cli.ts",
    "db:seed:review": "tsx migrations/fixtures/review-user.ts",
    "typecheck": "tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test": "npm run test:unit && npm run test:integration && npm run test:contract",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:contract": "vitest run --project contract",
    "test:e2e": "playwright test",
    "test:performance": "vitest run --project performance"
  },
  "dependencies": {
    "@fastify/cookie": "11.0.2",
    "@fastify/static": "10.1.4",
    "argon2": "0.45.1",
    "better-sqlite3": "13.0.0",
    "cheerio": "1.2.0",
    "fastify": "5.12.5",
    "ipaddr.js": "2.3.0",
    "nodemailer": "10.0.10",
    "pino": "10.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "rehype-sanitize": "6.0.0",
    "undici": "7.29.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "9.38.0",
    "@playwright/test": "1.61.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.10.0",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "9.2.4",
    "eslint": "9.38.0",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.24",
    "globals": "16.5.0",
    "jsdom": "27.1.0",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2",
    "vite": "8.3.0",
    "vitest": "4.1.11"
  }
}
