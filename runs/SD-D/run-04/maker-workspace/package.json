{
  "name": "bookmark-manager",
  "version": "1.0.0",
  "description": "Single-user bookmark manager with rich metadata, advanced search, archiving, saved views, preservation, and import/export.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node --test --experimental-test-isolation=none 'tests/unit/**/*.test.js' 'tests/integration/**/*.test.js'",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "express": "^4.21.2",
    "sanitize-html": "^2.14.0"
  },
  "devDependencies": {
    "@playwright/test": "1.61.0",
    "playwright": "1.61.0"
  }
}
