{
  "name": "bookmark-manager",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": ["client", "server", "shared"],
  "scripts": {
    "build": "npm run build -w shared && npm run build -w client && npm run build -w server",
    "dev": "concurrently -k \"npm run dev -w server\" \"npm run dev -w client\"",
    "start": "npm run db:migrate && node server/dist/server.js",
    "db:migrate": "tsx server/src/db/migrate.ts",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@playwright/test": "1.61.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.5.2",
    "concurrently": "^9.2.1",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1",
    "vitest": "^3.2.4"
  }
}
