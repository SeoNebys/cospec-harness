{
  "name": "bookmark-manager",
  "version": "1.0.0",
  "description": "Single-user bookmark manager (Spec-Driven Development)",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node src/server.js",
    "migrate": "node src/db/migrate.js",
    "test": "node --test --test-concurrency=1 --test-force-exit 'tests/unit/**/*.test.js' 'tests/integration/**/*.test.js'",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "express": "^4.21.2",
    "markdown-it": "^14.1.0",
    "multer": "^1.4.5-lts.1",
    "node-html-parser": "^6.1.13",
    "playwright": "1.61.0",
    "sanitize-html": "^2.14.0"
  },
  "devDependencies": {
    "@playwright/test": "1.61.0"
  }
}
