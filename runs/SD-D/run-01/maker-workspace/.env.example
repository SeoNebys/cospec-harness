DATABASE_PATH=data/bookmarks.sqlite
HOST=0.0.0.0
PORT=4000
COOKIE_SECURE=false
SESSION_HOURS=720
# Only used by npm run seed:review; there are no built-in production credentials.
REVIEW_EMAIL=review@example.com
REVIEW_PASSWORD=choose-a-long-review-password
# Test-only deterministic metadata transport; leave false in normal environments.
METADATA_TEST_FIXTURES=false
