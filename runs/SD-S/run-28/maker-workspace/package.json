{
  "name": "bookmark-manager",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 4000",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 4000",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:contract": "vitest run tests/contract",
    "test:e2e": "playwright test",
    "test:performance": "vitest run tests/performance",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx db/seed.ts",
    "db:rebuild-search": "tsx scripts/rebuild-search.ts",
    "db:backup": "tsx scripts/backup-db.ts",
    "db:cleanup-icons": "tsx scripts/cleanup-icons.ts"
  },
  "dependencies": {
    "better-auth": "1.7.6",
    "better-sqlite3": "13.0.3",
    "cheerio": "1.2.0",
    "ipaddr.js": "2.5.0",
    "lucide-react": "1.48.0",
    "next": "16.3.6",
    "nodemailer": "10.0.10",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "undici": "8.11.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@playwright/test": "1.61.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.3",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.6",
    "prettier": "3.8.2",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  },
  "overrides": {
    "playwright-core": "1.61.0",
    "esbuild": "0.28.1"
  }
}
