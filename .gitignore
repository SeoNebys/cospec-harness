# Runtime working area — recreated per run by setup, archived to runs/ by teardown
_work/

# Secrets
.env
*.env

# Rendered previews cache (regenerated)
*.pyc
__pycache__/
.venv/

# Regenerable build artifacts inside archived run workspaces.
runs/**/maker-workspace/dist/
runs/**/maker-workspace/release/
runs/**/maker-workspace/build/
runs/**/node_modules/
runs/**/.venv/
