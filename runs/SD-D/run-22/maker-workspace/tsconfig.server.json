{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "outDir": "dist/server",
    "rootDir": "src",
    "baseUrl": ".",
    "paths": { "@server/*": ["src/server/*"], "@shared/*": ["src/shared/*"] },
    "types": ["node"]
  },
  "include": ["src/server", "src/shared"]
}
