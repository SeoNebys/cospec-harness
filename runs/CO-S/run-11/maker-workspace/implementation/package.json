{
  "name": "bookmarks-app",
  "version": "1.0.0",
  "private": true,
  "description": "Personal bookmark manager — save, tag, search, read-status, archive.",
  "type": "commonjs",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "node --expose-gc --test test/unit/*.test.js",
