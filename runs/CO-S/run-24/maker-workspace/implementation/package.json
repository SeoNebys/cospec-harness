{
  "name": "bookmark-app",
  "version": "1.0.0",
  "description": "Personal bookmark manager — save, tag, note, read-later, and find links",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "test:unit": "node --test test/unit/*.test.js",
    "test:acceptance": "node --test test/acceptance/*.test.js",
    "test": "node --test test/unit/*.test.js && node --test test/acceptance/*.test.js"
  },
  "devDependencies": {
    "playwright": "1.61.0"
  }
}
