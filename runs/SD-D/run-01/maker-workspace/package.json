{
  "name": "bookmark-manager",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.21" },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist/server/server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --project node --project dom",
    "test:contract": "vitest run --project node tests/contract",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "seed:review": "tsx src/server/db/seed-review.ts"
    ,"db:migrate": "tsx src/server/db/migrate-cli.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/multipart": "10.1.1",
    "@fastify/static": "10.1.3",
    "@fastify/type-provider-typebox": "6.1.0",
    "fastify": "5.12.5",
    "parse5": "8.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "sharp": "0.35.4",
    "typebox": "1.3.32",
    "undici": "8.10.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "1.61.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "jsdom": "^27.2.0",
    "prettier": "^3.7.4",
    "tsx": "^4.21.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.48.1",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
