{
  "manifest_version": 3,
  "name": "My Links",
  "version": "0.1.0",
  "description": "Your personal library of saved links — private, on your own machine.",
  "permissions": ["storage", "activeTab", "tabs", "scripting"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save this page to My Links"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "library.html",
    "open_in_tab": true
  }
}
