NODE_ENV=development
HOST=0.0.0.0
PORT=4000
DATABASE_PATH=/work/data/bookmarks.sqlite
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://maker:4000
BETTER_AUTH_TRUSTED_ORIGINS=http://maker:4000,http://127.0.0.1:4000,http://localhost:4000
REVIEW_MODE=1
REVIEW_USER_A_EMAIL=alice@example.test
REVIEW_USER_A_PASSWORD=Bookmarks-Alice-2026!
REVIEW_USER_B_EMAIL=bob@example.test
REVIEW_USER_B_PASSWORD=Bookmarks-Bob-2026!

# Production: use one exact HTTPS public origin, a newly generated secret,
# REVIEW_MODE=0, and a persistent writable DATABASE_PATH. Run migrations before
# starting the server. The metadata fetcher also requires controlled DNS and
# outbound HTTP(S) egress; enforce network-level denial of private ranges too.
