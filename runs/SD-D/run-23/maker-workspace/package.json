{
  "name": "bookmark-manager",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.21.0 <25" },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/src/server/index.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run --project unit --project component",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "db:migrate": "tsx src/server/db/migrate.ts",
    "db:seed:review": "tsx scripts/seed-review-user.ts"
  },
  "dependencies": {
    "@fastify/secure-session": "8.4.0",
    "@fastify/static": "10.1.4",
    "@node-rs/argon2": "2.2.1",
    "@tanstack/react-query": "5.103.2",
    "better-sqlite3": "13.0.3",
    "cheerio": "1.2.0",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.5",
    "ipaddr.js": "2.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "react-router": "7.18.4",
    "rehype-sanitize": "6.0.0",
    "undici": "8.11.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.61.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.5.0",
    "globals": "16.5.0",
    "jsdom": "27.2.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.1",
    "vite": "8.3.1",
    "vitest": "5.0.1"
  }
}
