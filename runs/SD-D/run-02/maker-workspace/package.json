{
  "name": "bookmark-manager",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "start": "node server/src/index.js",
    "build": "npm --workspace web run build",
    "dev": "node server/src/index.js",
    "test": "node --test --test-isolation=none server/tests/*.test.js",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.61.0"
  }
}
