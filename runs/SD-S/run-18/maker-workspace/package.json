{
  "name": "bookmark-manager",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "react-router dev --host 0.0.0.0 --port 4000",
    "build": "react-router build",
    "start": "HOST=${HOST:-0.0.0.0} PORT=${PORT:-4000} react-router-serve build/server/index.js",
    "start:review": "NODE_ENV=development REVIEW_MODE=1 BETTER_AUTH_SECRET=review-only-bookmark-secret-2026-change-me BETTER_AUTH_URL=http://maker:4000 BETTER_AUTH_TRUSTED_ORIGINS=http://maker:4000,http://127.0.0.1:4000 HOST=0.0.0.0 PORT=4000 react-router-serve build/server/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "react-router typegen && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx app/db/migrate.server.ts",
    "seed:review": "tsx scripts/seed-review-users.ts",
    "db:reset:e2e": "tsx scripts/reset-e2e-db.ts",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:security": "vitest run --project security",
    "test:contract": "vitest run --project contract",
    "test:performance": "vitest run --project performance",
    "test:e2e": "playwright test",
    "test:all": "npm run lint && npm run typecheck && npm run test:unit && npm run test:integration && npm run test:security && npm run test:contract && npm run test:performance && npm run build && npm run test:e2e",
    "verify": "npm run test:all"
  },
  "dependencies": {
    "@react-router/node": "8.4.0",
    "@react-router/serve": "8.4.0",
    "better-auth": "1.7.5",
    "better-sqlite3": "13.0.3",
    "cheerio": "1.2.0",
    "drizzle-orm": "0.45.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "zod": "4.6.5",
    "isbot": "^5"
  },
  "devDependencies": {
    "@playwright/test": "1.61.0",
    "@react-router/dev": "8.4.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@typescript-eslint/eslint-plugin": "8.70.1",
    "@typescript-eslint/parser": "8.70.1",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.24",
    "jsdom": "27.1.0",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
